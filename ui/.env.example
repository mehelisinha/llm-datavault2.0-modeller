# Frontend env template. Copy to `.env.local` and edit; never commit secrets.
#
# Browser-exposed values must be prefixed with VITE_ (Vite contract).

# Base URL the typed API client points to. Same-origin in production
# (FastAPI serves the SPA), localhost:8000 in development via the Vite proxy.
VITE_API_BASE_URL=

# Development reviewer identity. Sent as the `X-Actor` header until Phase B7
# wires Entra ID. Replace with your AD email locally.
VITE_DEV_ACTOR=dev@local

# Optional: override Vite dev server target for the API proxy.
VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: override Vite dev server port.
VITE_DEV_PORT=5173
