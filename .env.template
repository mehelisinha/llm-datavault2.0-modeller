# =============================================================================
# DWA AI Layer — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in the values produced by
# `devops/ai/00_provision.ps1`. NEVER commit `.env` (it is gitignored).
#
# All variables use the `DWA_AI_` prefix and are loaded by
# `dbt_builder.src.ai.settings.AISettings` (pydantic-settings).
# =============================================================================

# ── Azure subscription / resource metadata (for traceability) ─────────────────
DWA_AI_AZURE_SUBSCRIPTION_ID=
DWA_AI_AZURE_RESOURCE_GROUP=rg-data-and-ai-chapter-database-refactoring
DWA_AI_AZURE_REGION=germanywestcentral

# ── Azure AI Foundry project ──────────────────────────────────────────────────
# Found in Foundry portal → Project overview → "Project details"
# Format: https://<aiservices-name>.services.ai.azure.com/api/projects/<project-name>
DWA_AI_FOUNDRY_PROJECT_ENDPOINT=

# ── Azure OpenAI (Phase 0: API-key auth; migrate to Entra ID later) ──────────
# Format: https://<aiservices-name>.openai.azure.com/
DWA_AI_AZURE_OPENAI_ENDPOINT=
DWA_AI_AZURE_OPENAI_API_KEY=
DWA_AI_AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (must match what was deployed in Foundry)
DWA_AI_CHAT_DEPLOYMENT_GPT4O=gpt-4o
DWA_AI_CHAT_DEPLOYMENT_GPT5=gpt-5
DWA_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Primary model used by Phase 2 modelling agents (gpt-5 = stronger reasoning,
# higher latency, fixed temperature=1.0; gpt-4o = lower latency, deterministic).
DWA_AI_PRIMARY_CHAT_DEPLOYMENT=gpt-5

# ── Vector backend (Phase 2) ──────────────────────────────────────────────────
# 'faiss' = local file at DWA_AI_VECTOR_CACHE_DIR (default for dev/CI, €0).
# 'azure' = Azure AI Search (requires DWA_AI_SEARCH_ENDPOINT + ADMIN_KEY below).
DWA_AI_VECTOR_BACKEND=faiss
DWA_AI_VECTOR_CACHE_DIR=.cache/ai

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Format: https://<search-name>.search.windows.net
DWA_AI_SEARCH_ENDPOINT=
DWA_AI_SEARCH_ADMIN_KEY=
DWA_AI_SEARCH_INDEX_PATTERNS=dv-patterns
DWA_AI_SEARCH_INDEX_DECISIONS=approved-decisions

# ── Application Insights (OpenTelemetry tracing) ──────────────────────────────
DWA_AI_APPINSIGHTS_CONNECTION_STRING=

# ── Discovery API mode ───────────────────────────────────────────────────────
# Controls how the /api/discovery/* endpoints source catalog / schema / table
# listings (and the optional /snapshot read).
#
#   stub        offline fixtures from poc/metadata/*.yaml (default; CI-safe)
#   spark       SHOW CATALOGS via PySpark / Databricks Connect (needs cluster)
#   databricks  Unity Catalog REST via databricks-sdk (no cluster, sub-second)
#
# Set to "databricks" + the three DWA_API_DATABRICKS_* vars below to make the
# UI dropdowns reflect ALL catalogs visible to your Databricks identity.
DWA_API_DISCOVERY_MODE=stub

# Workspace URL — copy from your Databricks browser tab.
#   e.g. https://redacted-host.example.net
# Falls back to DATABRICKS_HOST (the SDK's own env var) when unset.
DWA_API_DATABRICKS_HOST=

# Auth — pick ONE strategy:
#
# A) Personal Access Token (PAT). Set:
#      DWA_API_DATABRICKS_TOKEN=dapi...
#      DWA_API_DATABRICKS_AUTH_TYPE=pat        # optional, SDK infers from token
#
# B) Azure CLI OAuth (preferred for ExampleCorp / Entra ID workspaces — no PAT to
#    rotate). Pre-req: `az login` once per session. Then leave the token blank:
#      DWA_API_DATABRICKS_TOKEN=
#      DWA_API_DATABRICKS_AUTH_TYPE=azure-cli
#
# C) Databricks CLI session (`databricks auth login`):
#      DWA_API_DATABRICKS_AUTH_TYPE=databricks-cli
#
# Leave DWA_API_DATABRICKS_AUTH_TYPE blank to let the SDK pick automatically.
DWA_API_DATABRICKS_TOKEN=
DWA_API_DATABRICKS_AUTH_TYPE=

# ── YAML Metadata store (ADLS Gen2) ──────────────────────────────────────────
# Leave DWA_AI_METADATA_STORE_ACCOUNT blank to use local filesystem storage
# (.cache/approved_yamls/) — suitable for dev and CI.
#
# For production, set the storage account name and service-principal creds.
# The SP must have "Storage Blob Data Contributor" on the container.
# Use the same SP that is registered in the Databricks secret scope (dwa-sp).
#
# Storage account name only — no .dfs.core.windows.net suffix.
DWA_AI_METADATA_STORE_ACCOUNT=
DWA_AI_METADATA_STORE_CONTAINER=dwa-metadata
DWA_AI_METADATA_STORE_SP_CLIENT_ID=
DWA_AI_METADATA_STORE_SP_CLIENT_SECRET=
DWA_AI_METADATA_STORE_TENANT_ID=

# ── Modeller tuning (Phase 2 — performance / quality / cost) ─────────────────
# These override the conservative defaults in `AISettings` (settings.py).
# Defaults are safe for tiny catalogs; tune up for production catalogs.
#
# Model used by the modelling agent. gpt-4o-mini is ~10× cheaper than gpt-4o
# and adequate for the constrained, schema-driven modelling task. Use gpt-4o
# (or gpt-5) for very large / ambiguous catalogs.
DWA_AI_MODELLER_CHAT_DEPLOYMENT=gpt-4o-mini

# Tables per LLM call. Tables exceeding this in one request are batched.
# Higher = fewer round-trips but bigger prompts (watch token limits).
DWA_AI_MODELLER_BATCH_SIZE=100

# Concurrent batches issued in parallel (bounded by MAX_CONCURRENT_LLM_CALLS
# and the TPM/RPM gates below). Set 0 to auto-pick from CPU count.
DWA_AI_MODELLER_BATCH_PARALLELISM=3

# Independent samples per (batch, table) for majority voting. 1 = no voting
# (fastest). 3 = robust voting, costs ~3× tokens. Voting fires when the catalog
# exceeds MODELLER_LARGE_CATALOG_THRESHOLD.
DWA_AI_MODELLER_BATCH_SAMPLES=3

# Maximum input tokens per modeller prompt. Raise if you have wide tables /
# rich descriptions so the model sees the full payload (richer satellites,
# more discovered links). gpt-4o-mini context window = 128k.
DWA_AI_MODELLER_MAX_PROMPT_TOKENS=40000

# max_tokens for completion. Bigger = room for many links + rich satellites.
DWA_AI_MODELLER_MAX_TOKENS_DEFAULT=16384

# ── Global LLM throttling (shared across all agents) ─────────────────────────
# Hard ceiling on concurrent in-flight Azure OpenAI calls.
DWA_AI_MAX_CONCURRENT_LLM_CALLS=8

# Token-per-minute budget. Set to your Azure OpenAI deployment's TPM quota.
# The modeller gates calls against a token bucket so you never hit 429s.
DWA_AI_LLM_TOKENS_PER_MINUTE=250000

# Requests-per-minute budget (defaults to deployment limit; leave unset to
# let MAX_CONCURRENT_LLM_CALLS be the only gate).
# DWA_AI_LLM_REQUESTS_PER_MINUTE=

# =============================================================================
# Production secret-handling (GitLab CI / Docker / Databricks)
# =============================================================================
# pydantic-settings reads from PROCESS ENV regardless of source. The same
# `AISettings` class works everywhere — only the injection mechanism changes.
#
# GitLab CI:
#   • Project → Settings → CI/CD → Variables (mark "Masked" + "Protected")
#   • Set DWA_AI_AZURE_OPENAI_API_KEY, DWA_AI_SEARCH_ADMIN_KEY,
#     DWA_AI_METADATA_STORE_SP_CLIENT_SECRET, DWA_API_DATABRICKS_TOKEN
#   • Non-secret vars (endpoints, deployment names) → `.gitlab-ci.yml` under
#     `variables:` so they live in source control.
#   • NEVER commit `.env`. The `.gitignore` already excludes it.
#
# Docker:
#   • Bake non-secret defaults into the image (ENV in Dockerfile).
#   • Inject secrets at runtime: `docker run --env-file <runtime-only.env>`
#     or `-e DWA_AI_AZURE_OPENAI_API_KEY=$VAR`.
#   • For AKS / Container Apps: use Azure Key Vault references + workload
#     identity; the SDK reads them as ordinary env vars.
#
# Databricks (jobs / cluster env):
#   • Store secrets in a Databricks secret scope: `databricks secrets create-scope dwa`
#   • Reference in `databricks.yml`:
#       environment_variables:
#         DWA_AI_AZURE_OPENAI_API_KEY: "{{secrets/dwa/openai-key}}"
#         DWA_API_DATABRICKS_TOKEN:    "{{secrets/dwa/db-token}}"
#   • Non-secrets stay inline in `databricks.yml`.
# =============================================================================

# =============================================================================
# Microsoft Entra ID (UI login + API JWT validation)
# =============================================================================
# Setting BOTH variables below enables JWT validation on the API. While they
# are blank the API stays in dev mode and accepts the `X-Actor` header, so
# local development continues to work unchanged.
#
# See documentation/docs/entra_login_setup.md for the click-through guide.
DWA_API_AAD_TENANT_ID=
DWA_API_AAD_API_CLIENT_ID=

# App role 'value' that grants admin privileges (case-insensitive). Match the
# value you typed when defining the role on the API app registration.
DWA_API_AAD_ADMIN_APP_ROLE=Admin

# Optional comma-separated email/UPN allowlist used as an admin fallback BEFORE
# you have assigned the app role to anyone (e.g. during initial rollout).
# Honoured in both Entra mode and dev (X-Actor) mode.
#   DWA_API_ADMIN_EMAILS=alice@example.com,bob@example.com
DWA_API_ADMIN_EMAILS=

# CORS — only needed when the UI is served from a DIFFERENT origin than the
# API (e.g. Vite dev server on :5173 hitting API on :8000 without the proxy,
# or a separately hosted SPA). Leave blank when FastAPI serves the built UI.
#   DWA_API_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://dwa.eon.com
DWA_API_CORS_ALLOWED_ORIGINS=
